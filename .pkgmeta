# Adapted from Azeroth Guild Finder (.pkgmeta), same owner, GPL-3.0 (ADR 0018).
package-as: AzerothAccord

# One source of truth for library versions: tools/fetch_libs.py reads this block for local development and CI;
# the BigWigs packager reads it for releases. Each entry is a whole repository at a tag (ADR 0011).
externals:
  AzerothAccord/Libs/Ace3:
    url: https://github.com/WoWUIDev/Ace3
    tag: Release-r1403
  AzerothAccord/Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
    tag: v1.1.4
  AzerothAccord/Libs/LibDBIcon-1.0:
    url: https://github.com/wowace-clone/LibDBIcon-1.0
    tag: v8.0.4

# The addon lives in a subfolder of the repository: the packager moves it to the top level of the package.
move-folders:
  AzerothAccord/AzerothAccord: AzerothAccord

# What stays out of the package. The packager skips every dotfile and dot-folder (.git, .idea, .github, .gitignore, ...)
# and every file git does not track, and a pattern here is matched against the path from the repository root with *
# crossing folders. LICENSE (the GPL-3.0 text) is not listed on purpose: it must ship, and it lands inside the addon
# folder because the repository root is the package. tools/check_package.py reads this file and fails if the licence
# would be left out or a development file would ship.
ignore:
  - Tests
  - docs
  - tools
  - .github
  - .gitignore
  - .luarc.json
  - "*.md"
  - prompt.txt
